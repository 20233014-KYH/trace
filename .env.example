# Trace 서버 환경변수 — 이 파일을 .env 로 복사해서 키를 채우세요.
#   cp .env.example .env
# ★ .env 는 깃에 올라가지 않습니다 (.gitignore). 키를 저장소에 넣지 마세요.

# ── Learn Mode AI ───────────────────────────────────────────
# 팀 결정 (2026-09-21): GPT-5.6 Luna
#   가격표상 OpenAI 최저가 440원/학기 < Qwen-Plus 650원/학기 라
#   가격·한국어·키 발급 어느 쪽으로도 Qwen 을 고를 이유가 없었다.
#   리포트와 Side Chat 은 같은 모델을 쓴다 — 채팅 내용이 맥락으로 남아
#   리포트에 들어가므로, 나누면 한 모델이 쓴 답을 다른 모델이 요약하게 된다.
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# 비교할 때만 쓰는 것 (server/compare_llm.py) — 평소엔 비워 둡니다
# DASHSCOPE_API_KEY=
# QWEN_MODEL=qwen-plus
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# 키가 하나도 없으면 LLM_PROVIDER 를 fake 로 두세요. 가짜 리포트가 나와
# 화면 개발은 계속할 수 있습니다.
# LLM_PROVIDER=fake

# ── DB ──────────────────────────────────────────────────────
# 비워 두면 SQLite 파일(3-코드/server/trace.db)을 씁니다. 개발은 이걸로 충분합니다.
# 배포(9주차)에는 Supabase 등 PostgreSQL 주소를 넣습니다. 코드는 그대로입니다.
# TRACE_DB_URL=postgresql://...
