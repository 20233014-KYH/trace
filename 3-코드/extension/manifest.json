{
  "manifest_version": 3,
  "name": "Trace",
  "version": "0.3.3",
  "description": "탭 전환과 AI 사이트의 질문·답 원문을 이 PC 의 Trace 수집기(127.0.0.1)에만 보낸다. 수집기가 가려서 PC 에 저장하고, 서버로는 해시만 간다.",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:5077/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://poe.com/*",
    "https://wrtn.ai/*",
    "https://*.wrtn.ai/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*",
    "https://notebooklm.google.com/*",
    "https://chat.mistral.ai/*",
    "https://clova-x.naver.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trace"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://poe.com/*",
        "https://wrtn.ai/*",
        "https://*.wrtn.ai/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://notebooklm.google.com/*",
        "https://chat.mistral.ai/*",
        "https://clova-x.naver.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "domains.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}