# 이 파일을 같은 폴더에 .env 로 복사하고 아래 줄을 채운다.  .env 는 git 에 올라가지 않는다 (.gitignore).
# 비워 두면 맥·PC 안의 파일 server/trace.db (SQLite) 를 쓴다.
#
# Supabase → 프로젝트 → 위쪽 [Connect] → "Session pooler" 의 주소를 복사해서
# [YOUR-PASSWORD] 를 (대괄호까지 지우고) 프로젝트 만들 때 정한 DB 비밀번호로 바꾼다.
#   ※ "Direct connection" 은 무료 플랜에서 IPv6 전용이라 집·학교 인터넷에서 안 붙을 수 있다.
TRACE_DB_URL=

# 구글 로그인 (10/15 · README "구글 로그인") — 구글 클라우드 OAuth 클라이언트(웹). 비우면 PC 앱의 Google 버튼이 "준비 중"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오 로그인 (10/15) — 카카오 디벨로퍼스 앱의 REST API 키 · Client Secret. 비우면 카카오 버튼이 "준비 중"
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
